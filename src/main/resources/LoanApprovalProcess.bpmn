<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_1rgr2bt" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.46.1" modeler:executionPlatform="Camunda Platform" modeler:executionPlatformVersion="7.24.0">
  <bpmn:process id="LoanApprovalProcess" name="Loan Approval Process" isExecutable="true" camunda:historyTimeToLive="180">
    <bpmn:startEvent id="LoanApprovalStartEvent" name="Loan Approval Start Event">
      <bpmn:outgoing>Flow_0b3wihd</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="Gateway_1yunpa6" name="Loan Approval Gateway">
      <bpmn:incoming>Flow_0b3wihd</bpmn:incoming>
      <bpmn:outgoing>Flow_1gavht6</bpmn:outgoing>
      <bpmn:outgoing>Flow_006xkw6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_0b3wihd" sourceRef="LoanApprovalStartEvent" targetRef="Gateway_1yunpa6" />
    <bpmn:serviceTask id="AutomaticApprovalServiceTask" name="Automatic Approval Service Task" camunda:class="com.furkankayam.service.LoanApprovalService">
      <bpmn:incoming>Flow_1gavht6</bpmn:incoming>
      <bpmn:outgoing>Flow_1r4ngq3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_1gavht6" name="amount &#60; 25000" sourceRef="Gateway_1yunpa6" targetRef="AutomaticApprovalServiceTask">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${amount &lt; 25000}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:userTask id="ManagerApprovalServiceTask" name="Manager Approval Service Task">
      <bpmn:incoming>Flow_006xkw6</bpmn:incoming>
      <bpmn:outgoing>Flow_0yeq7z0</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_006xkw6" name="amount &#62;= 25000" sourceRef="Gateway_1yunpa6" targetRef="ManagerApprovalServiceTask">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${amount &gt;= 25000}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:exclusiveGateway id="Gateway_12clqm6" name="Is Approvad ?">
      <bpmn:incoming>Flow_0yeq7z0</bpmn:incoming>
      <bpmn:outgoing>Flow_1pym62u</bpmn:outgoing>
      <bpmn:outgoing>Flow_0037y0z</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_0yeq7z0" sourceRef="ManagerApprovalServiceTask" targetRef="Gateway_12clqm6" />
    <bpmn:serviceTask id="RejectServiceTask" name="Reject Service Task" camunda:class="com.furkankayam.service.LoanRejectService">
      <bpmn:incoming>Flow_0037y0z</bpmn:incoming>
      <bpmn:incoming>Flow_0d6dcos</bpmn:incoming>
      <bpmn:outgoing>Flow_0biyt5v</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="ManualApprovalServiceTask" name="Manual Approval Service Task" camunda:class="com.furkankayam.service.LoanApprovalService">
      <bpmn:incoming>Flow_1pym62u</bpmn:incoming>
      <bpmn:outgoing>Flow_0ue7sr0</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_1pym62u" name="approved == true" sourceRef="Gateway_12clqm6" targetRef="ManualApprovalServiceTask">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${approved == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_0037y0z" name="approved == false" sourceRef="Gateway_12clqm6" targetRef="RejectServiceTask">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${approved == false}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:serviceTask id="CompleteRequestServiceTask" name="Complete Request Service Task" camunda:class="com.furkankayam.service.CompleteRequestService">
      <bpmn:incoming>Flow_1r4ngq3</bpmn:incoming>
      <bpmn:incoming>Flow_0biyt5v</bpmn:incoming>
      <bpmn:incoming>Flow_0ue7sr0</bpmn:incoming>
      <bpmn:outgoing>Flow_1phby65</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_1r4ngq3" sourceRef="AutomaticApprovalServiceTask" targetRef="CompleteRequestServiceTask" />
    <bpmn:sequenceFlow id="Flow_0biyt5v" sourceRef="RejectServiceTask" targetRef="CompleteRequestServiceTask" />
    <bpmn:sequenceFlow id="Flow_0ue7sr0" sourceRef="ManualApprovalServiceTask" targetRef="CompleteRequestServiceTask" />
    <bpmn:endEvent id="LoanRequestEndEvent" name="Loan Request End Event">
      <bpmn:incoming>Flow_1phby65</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1phby65" sourceRef="CompleteRequestServiceTask" targetRef="LoanRequestEndEvent" />
    <bpmn:boundaryEvent id="TenSecondTimerEvent" name="Ten Second Timer Event" attachedToRef="ManagerApprovalServiceTask">
      <bpmn:outgoing>Flow_0d6dcos</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerEventDefinition_025rhzb">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT10S</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="Flow_0d6dcos" name="Ten second time is expired." sourceRef="TenSecondTimerEvent" targetRef="RejectServiceTask" />
  </bpmn:process>
